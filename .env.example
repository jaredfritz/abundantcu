# Every variable is optional. With none set, the site builds and runs: the /data maps, the
# crash dashboard, and the zoning explorer work, address search uses OpenStreetMap (Nominatim),
# writings use local seed data, the parking map shows a "not configured" notice, and the email
# signup form reports that signups aren't set up.
# Copy to .env.local and fill in what you use.

# --- Address search -------------------------------------------------------------------------
# Google geocoding and autocomplete for address search. Without it, search uses Nominatim.
GOOGLE_MAPS_API_KEY=
# Nominatim's usage policy asks for a User-Agent naming your app and a contact.
NOMINATIM_USER_AGENT="YourApp/1.0 (you@example.org)"

# --- Parking map (needs all three) ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Parking map editor access (server side) ------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
EDITOR_ADMIN_TOKEN=
# Comma-separated addresses notified of editor access requests.
EDITOR_NOTIFICATION_RECIPIENTS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_BASE_URL=

# --- Yard waste email reminders -------------------------------------------------------------
# /data/yard-waste offers email reminders before each pickup when these are all set:
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (run supabase/yard_waste_reminders_schema.sql first),
# RESEND_API_KEY and RESEND_FROM_EMAIL (above), and CRON_SECRET (below) for the daily send job. Links in the
# emails use NEXT_PUBLIC_BASE_URL. Without them the page offers a calendar download instead.
# Daily owner report of reminders sent and any errors (comma-separated; defaults to EDITOR_NOTIFICATION_RECIPIENTS).
YARD_WASTE_REPORT_EMAIL=

# --- Email signup form ----------------------------------------------------------------------
# Signups are posted to this webhook (e.g. a Google Apps Script that appends to a Sheet). In
# production the form also needs the Turnstile keys; without them it rejects submissions.
GOOGLE_SHEETS_WEBHOOK_URL=
OWNER_EMAIL_WEBHOOK_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Writings from Sanity (otherwise local seed data) ---------------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_READ_TOKEN=
SANITY_REVALIDATE_SECONDS=

# --- Rate limiting across server instances (otherwise in memory) ----------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled jobs -------------------------------------------------------------------------
# Protects /api/supabase-keepalive and /api/yard-waste/reminders/send (vercel.json schedules both on Vercel).
# The reminder job won't run in production without it.
CRON_SECRET=
